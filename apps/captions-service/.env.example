# Copy to .env before running docker compose up

# Whisper model size: tiny, base, small, medium, large-v3.
# Bigger = more accurate but slower and more RAM/VRAM.
WHISPER_MODEL_SIZE=base

# cpu or cuda (cuda needs an NVIDIA GPU + nvidia-container-toolkit on the host)
WHISPER_DEVICE=cpu

# int8 is fastest on CPU. Use float16 if WHISPER_DEVICE=cuda.
WHISPER_COMPUTE_TYPE=int8

MAX_UPLOAD_MB=500
JOB_TTL_SECONDS=21600

# Required. A random shared secret the BASE web app sends as the
# X-API-Key header. Without this, anyone who finds the server's URL/port
# could run (expensive) transcription jobs on your machine for free.
# Generate one with: openssl rand -hex 32
CAPTIONS_API_KEY=
